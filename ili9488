// Command byte function 
static void ili9488_cmd (uint8_t cmd)
{
    gpio_set_level (DCRS, 0); // Pull DC low for command mode
    spi_transaction_t t = 
    {
        0
    };
    t.length = 8, // 1 byte
    t.tx_buffer = &cmd, // Fill buffer with command
    spi_device_polling_transmit(spi_device, &t); // Blocking
}

// Incoming data function
static void ili9488_data (const uint8_t *data, int length)
{
    if (length <= 0)
    {
        return; // Return if no data
    }

    gpio_set_level (DCRS, 1); // Pull DC high for data mode
    spi_transaction_t t =
    {
        0
    };
    t.length = (size_t)length * 8, // Convert to bits
    t.tx_buffer = data, // Fill buffer with data
    spi_device_polling_transmit(spi_device, &t); 
}

// Drawing window function
static void ili9488_set_window (int x0, int y0, int x1, int y1)
{
    uint8_t data[4]; 

    ili9488_cmd (0x2A); // Column address set
    data[0] = (x0 >> 8) & 0xFF; // Start column
    data[1] = x0 & 0xFF; 
    data[2] = (x1 >> 8) & 0xFF; // End column
    data[3] = x1 & 0xFF;
    ili9488_data (data, 4); 

    ili9488_cmd (0x2B); // Page address set
    data[0] = (y0 >> 8) & 0xFF; // Start row
    data[1] = y0 & 0xFF; 
    data[2] = (y1 >> 8) & 0xFF; // End row
    data[3] = y1 & 0xFF;
    ili9488_data (data, 4); 
    
    ili9488_cmd (0x2C); // Memory Write
}

void ili9488_initialization (void)
{
    gpio_config_t io_config = // Set DC and RST for GPIO output
    {
        .pin_bit_mask = (1ULL << DCRS) | (1ULL << RST),
        .mode = GPIO_MODE_OUTPUT,
    };
    gpio_config (&io_config);

    spi_bus_config_t bus_config = // Configure SPI Bus
    {
        .miso_io_num = -1, // Write only
        .mosi_io_num = MOSI, // Set MOSI GPIO 23 
        .sclk_io_num = CLK, // Set Serial Clock GPIO 18
        .quadwp_io_num = -1, // Disable quad write project
        .quadhd_io_num = -1, // Disable quad hold 
        .max_transfer_sz = WIDTH * HEIGHT * 2, // DMA max buffer
    };

    spi_device_interface_config_t device_config = // Attach ILI9488 to ESP32 SPI
    {
        .clock_speed_hz = 60000000, // Set 60 MHz SPI clock
        .mode = 0, // Clock idle low, read on rising edge
        .spics_io_num = CS, // Set chip select GPIO 5
        .queue_size = 7, // Handle up to 7 transactions queued 
        .flags = SPI_DEVICE_NO_DUMMY | SPI_DEVICE_HALFDUPLEX, // Disable clock limits
        .pre_cb = NULL,
    };

    ESP_ERROR_CHECK (spi_bus_initialize(SPI2_HOST, &bus_config, SPI_DMA_CH_AUTO)); // Initialize SPI with bus configurations
    ESP_ERROR_CHECK (spi_bus_add_device(SPI2_HOST, &device_config, &spi_device)); // Add ESP32 SPI

    // Hardware reset pulse sequence
    gpio_set_level (RST, 0); 
    vTaskDelay(pdMS_TO_TICKS(100)); // Hold reset for 100 ms
    gpio_set_level (RST, 1); 
    vTaskDelay(pdMS_TO_TICKS(100)); // Hold post-reset for 100 ms

    // Software reset 
    ili9488_cmd (0x01); 
    vTaskDelay(pdMS_TO_TICKS(120)); // Hold post-reset for 120 ms

    // Set pixel format
    ili9488_cmd (0x3A); 
    uint8_t pixel_format = 0x66; 
    ili9488_data (&pixel_format, 1); // Set data to pixel format RGB565

    // Set memory access control - Horizontal format
    ili9488_cmd (0x36);
    uint8_t madctl = 0x28; // Memory Data Access Control
    ili9488_data (&madctl, 1); // Set data to MADCTL format

    // Wake display
    ili9488_cmd (0x11); // Sleep out
    vTaskDelay(pdMS_TO_TICKS(120)); 
    ili9488_cmd (0x29); // Turn display on
}

// Clear by writing a continuous block buffer 
void ili9488_clear(uint16_t color)
{
    ili9488_set_window(0, 0, WIDTH - 1, HEIGHT - 1); // Set window

    static uint8_t buffer[3072];
    uint8_t r = (color >> 8) & 0xF8;
    uint8_t g = (color >> 3) & 0xFC;
    uint8_t b = (color << 3) & 0xF8;

    for (int i = 0; i < 1024; i++) // Fill 1024-pixel chunk buffer in SRAM
    {
        buffer[i * 3] = r;
        buffer[i * 3 + 1] = g;
        buffer[i * 3 + 2] = b;
    } 

    int total_bytes = WIDTH * HEIGHT * 3; // Get total bytes
    while (total_bytes > 0) // While total bytes are > 0, push via SPI chunks
    {
        int chunk = (total_bytes > sizeof(buffer)) ? sizeof(buffer) : total_bytes;
        ili9488_data (buffer, chunk); // Write chunk to buffer
        total_bytes -= chunk; // Adjust total bytes
        //vTaskDelay(1); // Delay for watchdog during large fills
    }
}

// Draw pixels
void ili9488_draw_pixel(int x, int y, uint16_t color)
{
    if (x < 0 || x >= WIDTH || y < 0 || y >= HEIGHT)
    {
        return; // If out of frame, return
    }

    ili9488_set_window(x, y, x, y); // Set 1x1 pixel window address

    // RGB666 Format
    uint8_t data[3];
    data[0] = (color >> 8) & 0xF8; // Reg 
    data[1] = (color >> 3) & 0xFC; // Green
    data[2] = (color << 3) & 0xF8; // Blue
    ili9488_data(data, 3);
}

// Draw buffered text
void ili9488_draw_text(int x, int y, const char *str, uint16_t color, uint16_t background)
{
	if (!str || x >= WIDTH || y >= HEIGHT)
	{
		return; // Bounds checking
	}

	static uint8_t buff[8 * 8 * 3]; // 18 bit color for 1 character

	uint8_t r = (color >> 8) & 0xF8;
    uint8_t g = (color >> 3) & 0xFC;
    uint8_t b = (color << 3) & 0xF8;
	uint8_t r_bg = (background >> 8) & 0xF8;
    uint8_t g_bg = (background >> 3) & 0xFC;
    uint8_t b_bg = (background << 3) & 0xF8;

	int curser_x = x; // X offset curser 

	while (*str)
		{
			char c = *str++;
			
			if (curser_x + 8 > WIDTH)
			{
				break; // Stop rendering once past edge
			}
			
			if (c < 32 || c > 126)
			{
				c = ' '; // ASCII range bounds
			}
			int font_index = c - ' '; // Get array index

			ili9488_set_window(curser_x, y, curser_x + 7, y + 7); // Set window for one 8x8 character
			int buff_index = 0; 

			for (int row = 0; row < 8; row++) // Loop through each column
			{
				for (int col = 0; col < 8; col++)
				{
				uint8_t line = font8x8[font_index][col];
				
				if (line & (1 << (row))) // Test if bit is set to 1
				{
					buff[buff_index++] = r; 
					buff[buff_index++] = g; 
					buff[buff_index++] = b; 
				}
				else // Bit is 0
				{
					buff[buff_index++] = r_bg; 
					buff[buff_index++] = g_bg; 
					buff[buff_index++] = b_bg; 
				}
			}
		}
		ili9488_data(buff, 192); // Transmit data
		curser_x += 8; // Update text curser 
	}
}

// Draw lines
void ili9488_draw_line(int x0, int y0, int x1, int y1, uint16_t color)
{
    int dx = abs(x1 - x0); // Horizontal distance between points
    int dy = -abs(y1 - y0); // Vertical distance between points
    int sx = (x0 < x1) ? 1 : -1; // Step direction along horizontal axis
    int sy = (y0 < y1) ? 1 : -1; // Step direction along vertical axis 
    int err = dx + dy; // Accumulator error variable

    // Bresenham's Line Algorithm
    while (1)
    {
        ili9488_draw_pixel(x0, y0, color);
        if (x0 == x1 && y0 == y1)
        {
            break; // Draw pixel at current coordinate, break if target reached
        }

        int e2 = 2 * err; 
        if (e2 > dy)
        {
            // Evaluate X step
            err += dy;
            x0 += sx;
        }
        if (e2 <= dx)
        {
            // Evaluate Y step
            err += dx;
            y0 += sy;
        }
    }
}

static int prev_y[WIDTH] = {0}; // Previous Y buffer
static int current_y[WIDTH] = {0}; // Current Y buffer 

void draw_waveform_frame (uint16_t *adc_samples, int trigger_index)
{
    for (int x = 0; x < WIDTH; x++)
    {
        int y = (HEIGHT - 1) - (adc_samples[trigger_index + x] * (HEIGHT - 1) / 4095);

        if (y < 0)
        {
            y = 0; // Clamp lower bound
        }
        if (y >= HEIGHT)
        {
            y = HEIGHT - 1; // Clamp upper bound
        }

        current_y[x] = y; // Update Y
    }

    for (int x = 0; x < WIDTH - 1; x++)
    {
        ili9488_draw_line (x, prev_y[x], x + 1, prev_y[x + 1], 0x0000); // Erase previous frame
    }

    for (int x = 0; x < WIDTH - 1; x++)
    {
        ili9488_draw_line (x, current_y[x], x + 1, current_y[x + 1], CYAN); // Draw new line
        prev_y[x] = current_y[x]; // Save previous Y coordinate
    }
    prev_y[WIDTH - 1] = current_y[WIDTH - 1]; // Save final Y coordinate
}

// Fast block write for bounded regions
void ili9488_fill_rectangle (uint16_t x, uint16_t y, uint16_t w, uint16_t h, uint16_t color)
{
	uint32_t pixels = w * h; // Total pixel count = width * height

	ili9488_set_window(x, y, x + w - 1, y + h -1); // Set bounds

	uint8_t color_buff[3] = // DMA buffer for color, 18 bit RGB666
	{
		(uint8_t)((color >> 8) & 0xF8), // Red
		(uint8_t)((color >> 3) & 0xFC), // Green
		(uint8_t)((color << 3) & 0xF8) // Blue
	}; 

	static uint8_t chunk_buff[300]; // SRAM buffer for burst SPI transfer
	for (int i = 0; i < 100; i++)
	{
		chunk_buff[i * 3] = color_buff[0]; // Red
		chunk_buff[i * 3 + 1] = color_buff[1]; // Green
		chunk_buff[i * 3 + 2] = color_buff[2]; // Blue
	}

	while (pixels > 0) // While pixels are present
	{
		uint32_t transmit_pixels = (pixels > 100) ? 100 : pixels; 
		ili9488_data (chunk_buff, transmit_pixels * 3); // Send chunk buffer and pixels to ILI9488
		pixels -= transmit_pixels; // Update pixels
	}
}

void draw_scope_waveform (uint16_t *current_y, uint16_t color)
{
	static uint16_t prev_y[WIDTH] = {0}; // Initialize previous y with array of pixel width
	static bool initial = false; // First draw / load-up

	if (!initial)
	{
		for (int i = 0; i < WIDTH; i++)
		{
			prev_y[i] = current_y[i]; // Sample baseline from initial frame
		}
		initial = true; // Update initial draw flag
		return; // Skip drawing on first frame
	}

	for (int x = 0; x < WIDTH - 1; x++)
	{
		ili9488_draw_line(x, prev_y[x], x + 1, prev_y[x + 1], BLACK); // Erase previous line segment
		ili9488_draw_line(x, current_y[x], x + 1, current_y[x + 1], color); // Erase previous line segment

		prev_y[x] = current_y[x]; // Update y-point
	}
	prev_y[WIDTH - 1] = current_y[WIDTH - 1];
}
